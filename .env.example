# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/efootball-world-cup

# JWT
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=7d

# Stripe (Payment)
STRIPE_PUBLIC_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_key

# Konami/eFootball API (Integration Ready)
EFOOTBALL_API_URL=https://api.konami.com/efootball
EFOOTBALL_API_KEY=your_api_key_here
EFOOTBALL_API_SECRET=your_api_secret_here
EFOOTBALL_ACCOUNT_VERIFICATION_ENDPOINT=https://api.konami.com/efootball/account/verify
EFOOTBALL_ACCOUNT_LOOKUP_ENDPOINT=https://api.konami.com/efootball/account/lookup

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password

# Admin
ADMIN_EMAIL=admin@efootballworldcup.com
ADMIN_PASSWORD=ChangeMe123!

# Frontend
REACT_APP_API_URL=http://localhost:5000/api
